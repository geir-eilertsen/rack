# Copy to .env beside compose.yaml. Docker Compose reads .env automatically.

# Required. From https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# The address this host is reached at, used by the QR codes on printed labels.
# Leave blank until the host has a stable URL — a label printed against the
# wrong base has to be reprinted.
RACK_PUBLIC_BASE_URL=

# Host port. Use 127.0.0.1:8123 if a reverse proxy on the same box fronts it.
#RACK_PORT=8123

# Pin to a published tag instead of following latest, e.g. sha-abc1234 or 0.1.0.
#RACK_TAG=latest

#RACK_SHOPPING_REGION=Norway
